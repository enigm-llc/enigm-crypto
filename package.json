{
  "name": "@enigm/crypto",
  "version": "1.0.0",
  "description": "Modular TypeScript hybrid cryptography SDK with portable Enigm messaging and key transparency",
  "sideEffects": false,
  "keywords": [
    "enigm",
    "cryptography",
    "post-quantum",
    "ml-kem",
    "ml-dsa",
    "end-to-end-encryption"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./dist-cjs/index.js",
      "import": "./dist/index.js",
      "require": "./dist-cjs/index.js",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "react-native": "./dist-cjs/core/index.js",
      "import": "./dist/core/index.js",
      "require": "./dist-cjs/core/index.js",
      "default": "./dist/core/index.js"
    },
    "./primitives": {
      "types": "./dist/primitives/index.d.ts",
      "react-native": "./dist-cjs/primitives/index.js",
      "import": "./dist/primitives/index.js",
      "require": "./dist-cjs/primitives/index.js",
      "default": "./dist/primitives/index.js"
    },
    "./protocols": {
      "types": "./dist/protocols/index.d.ts",
      "react-native": "./dist-cjs/protocols/index.js",
      "import": "./dist/protocols/index.js",
      "require": "./dist-cjs/protocols/index.js",
      "default": "./dist/protocols/index.js"
    },
    "./codecs": {
      "types": "./dist/codecs/index.d.ts",
      "react-native": "./dist-cjs/codecs/index.js",
      "import": "./dist/codecs/index.js",
      "require": "./dist-cjs/codecs/index.js",
      "default": "./dist/codecs/index.js"
    },
    "./sdk": {
      "types": "./dist/sdk/index.d.ts",
      "react-native": "./dist-cjs/sdk/index.js",
      "import": "./dist/sdk/index.js",
      "require": "./dist-cjs/sdk/index.js",
      "default": "./dist/sdk/index.js"
    }
  },
  "files": [
    "dist",
    "dist-cjs",
    "src",
    "examples",
    "README.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "NOTICE",
    "LICENSE",
    "docs/PROTOCOL.md",
    "docs/THREAT-MODEL.md",
    "docs/KEY-TRANSPARENCY.md",
    "docs/REACT-NATIVE.md",
    "docs/SDK.md",
    "docs/ADAPTERS.md",
    "docs/RELEASE.md",
    "THIRD-PARTY-LICENSES.txt",
    "CHANGELOG.md",
    "docs/PRIVACY.md",
    "docs/SECURITY-ASSESSMENT.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "test:runtime": "npm run build && node scripts/verify-text-runtime.mjs",
    "benchmark": "node --import tsx test/benchmark.ts",
    "examples": "npm run build && node --import tsx examples/envelope.ts && node --import tsx examples/session.ts && node --import tsx examples/group-and-content.ts && node --import tsx examples/key-transparency.ts && node --import tsx examples/sealed-sender.ts && node --import tsx examples/sdk.ts && node --import tsx examples/messages.ts",
    "pack:verify": "npm run build && node scripts/verify-reproducible-pack.mjs",
    "sbom": "npm sbom --package-lock-only --sbom-format cyclonedx --sbom-type library",
    "prepack": "npm run build",
    "test:package": "npm run build && node scripts/verify-package-consumers.mjs",
    "release:check": "node scripts/verify-release.mjs && npm run build && node scripts/verify-public-package.mjs"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@noble/ciphers": "2.3.0",
    "@noble/curves": "2.3.0",
    "@noble/hashes": "2.3.0",
    "@noble/post-quantum": "0.7.0"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "esbuild": "0.25.12",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "tag": "latest",
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/enigm-llc/enigm-crypto.git"
  },
  "homepage": "https://github.com/enigm-llc/enigm-crypto#readme",
  "bugs": {
    "url": "https://github.com/enigm-llc/enigm-crypto/issues"
  }
}
